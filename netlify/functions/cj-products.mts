const BASE="https://developers.cjdropshipping.com/api2.0/v1";
const ALLOWED=new Set(["electronics","smart home","computer accessories","phone accessories","wearable technology","car accessories","beauty","solar energy","fitness","home decor","educational toys","pet supplies"]);
async function token(key:string){const r=await fetch(BASE+"/authentication/getAccessToken",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({apiKey:key})});const j=await r.json();if(!r.ok||!j?.data?.accessToken)throw new Error("CJ authentication failed");return j.data.accessToken as string}
export default async(req:Request)=>{if(req.method!=="GET")return Response.json({error:"Method not allowed"},{status:405});const key=Netlify.env.get("CJ_API_KEY");if(!key)return Response.json({error:"CJ is not configured"},{status:503});const u=new URL(req.url),raw=(u.searchParams.get("q")||"electronics").toLowerCase(),q=ALLOWED.has(raw)?raw:"electronics";try{const access=await token(key),p=new URL(BASE+"/product/listV2");p.searchParams.set("page","1");p.searchParams.set("size","30");p.searchParams.set("keyWord",q);const r=await fetch(p,{headers:{"CJ-Access-Token":access}}),j=await r.json();if(!r.ok||j?.success===false)return Response.json({error:"CJ product request failed"},{status:502});return Response.json({ok:true,supplier:"cj",query:q,data:j.data})}catch{return Response.json({error:"CJ request failed"},{status:502})}};
export const config={path:"/api/cj-products"};

